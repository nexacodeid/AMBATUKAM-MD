handler.help = ['menu']
handler.command = ['menu']
handler.tags = ['main']

export default handler

function clockString(ms) {

  const h = isNaN(ms)
    ? '--'
    : Math.floor(ms / 3600000)

  const m = isNaN(ms)
    ? '--'
    : Math.floor(ms / 60000) % 60

  const s = isNaN(ms)
    ? '--'
    : Math.floor(ms / 1000) % 60

  return `${h} H ${m} M ${s} S`
}